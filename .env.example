# Local small model (GraphRAG stage) — served by Ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5-coder:7b

# Cloud LLM (final reasoning stage) — any OpenAI-compatible endpoint
CLOUD_LLM_BASE_URL=https://api.openai.com/v1
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gpt-4o-mini

# Convenience: if only DEEPSEEK_KEY is set, the engine auto-defaults to
# base_url=https://api.deepseek.com/v1 and model=deepseek-chat.
DEEPSEEK_KEY=
